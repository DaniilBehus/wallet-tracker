# Copy to .env and set JWT_SECRET to a long random string.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
PORT=3000
DB_PATH=./data/wallet.db

# ---- AI expense entry (optional; spec/ai-expense-entry.md) -----------------
# off (default) · live. Demo is not set here: run `npm run ai:demo`.
WALLET_AI_MODE=off
# Provider: openai (default when empty) · gemini. An unknown value enables
# nothing; there is no fallback from one provider to the other.
# gemini = Gemini Free, SYNTHETIC EVALUATION ONLY: the app refuses it even with a
# key, because Free Tier input may be used by Google to improve its products.
WALLET_AI_PROVIDER=
# OpenAI live mode needs all three. A key alone enables nothing.
OPENAI_API_KEY=
WALLET_AI_MODEL=
WALLET_AI_LIVE_ALLOWED=false
# Pilot limits (defaults shown). They cap spending; raise them deliberately.
# The four call limits below apply to the app only; the live evaluator does not
# read them (it has its own allowance and window, see WALLET_AI_EVAL_DAILY_CALLS).
# WALLET_AI_TIMEOUT_MS=15000
# WALLET_AI_MAX_OUTPUT_TOKENS=600
# WALLET_AI_GLOBAL_DAILY_CALLS=20
# WALLET_AI_USER_DAILY_CALLS=5
# WALLET_AI_USER_MINUTE_CALLS=3
# WALLET_AI_MAX_CONCURRENT=2
# Real-model evaluation only: `npm run eval:ai:live -- --limit N` (qa/docs/ai-evaluation.md §6)
WALLET_AI_EVAL_LIVE=false
# The evaluation's own finite daily allowance (accepted 1-200). Do NOT raise the
# pilot limits above for an evaluation: they are the app's limits too.
# Independently of this, the evaluator never makes more than 5 provider calls in
# any rolling 10 minutes (fixed in qa/ai/eval-window.js, not configurable here).
WALLET_AI_EVAL_DAILY_CALLS=5
# Gemini Free for the synthetic evaluation corpus only. Add the key to a local
# .env only, never to git. Check the model id and its rate limits in Google AI
# Studio; they are not configured here. A real request is always a deliberate,
# separate step (`npm run eval:ai:live`).
GEMINI_API_KEY=
WALLET_AI_GEMINI_MODEL=
