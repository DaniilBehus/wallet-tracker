<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_CatLimit" targetNamespace="https://github.com/DaniilBehus/wallet-tracker/analysis">
  <bpmn:collaboration id="Collaboration_CatLimit">
    <bpmn:participant id="Pool_Person" name="Authenticated person / browser"/>
    <bpmn:participant id="Pool_System" name="PLANNED Wallet category limits — specification, not implemented" processRef="Process_CatLimit"/>
    <bpmn:messageFlow id="CatRequest" name="Limit write or expense" sourceRef="Pool_Person" targetRef="CatStart"/>
    <bpmn:messageFlow id="CatReply" name="Breakdown with states" sourceRef="CatDisplay" targetRef="Pool_Person"/>
    <bpmn:messageFlow id="CatError" name="400 or 404" sourceRef="CatRefuse" targetRef="Pool_Person"/>
  </bpmn:collaboration>
  <bpmn:process id="Process_CatLimit" isExecutable="false">
    <bpmn:startEvent id="CatStart" name="Action received"><bpmn:outgoing>Cat01</bpmn:outgoing><bpmn:messageEventDefinition id="CatStartMessage"/></bpmn:startEvent>
    <bpmn:serviceTask id="CatValidate" name="Validate input; PATCH needs positive id and monthly_limit_cents only: integer 0…100000000 or null; empty body invalid"><bpmn:incoming>Cat01</bpmn:incoming><bpmn:outgoing>Cat02</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="CatValid" name="Valid?" default="CatBad" gatewayDirection="Diverging"><bpmn:incoming>Cat02</bpmn:incoming><bpmn:outgoing>CatGood</bpmn:outgoing><bpmn:outgoing>CatBad</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:sendTask id="CatRefuse" name="Return 400 VALIDATION_FAILED, or 404 NOT_FOUND for a category missing or not this account's; nothing changes"><bpmn:incoming>CatBad</bpmn:incoming><bpmn:incoming>CatNotOwned</bpmn:incoming><bpmn:outgoing>Cat03</bpmn:outgoing></bpmn:sendTask>
    <bpmn:endEvent id="CatRefused" name="Action refused"><bpmn:incoming>Cat03</bpmn:incoming></bpmn:endEvent>
    <bpmn:exclusiveGateway id="CatOperation" name="Action type" default="DoCatExpense" gatewayDirection="Diverging"><bpmn:incoming>CatGood</bpmn:incoming><bpmn:outgoing>DoCatWrite</bpmn:outgoing><bpmn:outgoing>DoCatExpense</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="CatExpense" name="POST /api/transactions or pay an instalment: saved whatever any category limit says"><bpmn:incoming>DoCatExpense</bpmn:incoming><bpmn:outgoing>Cat04</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="CatFind" name="PATCH /api/categories/:id: look the category up among this account's own"><bpmn:incoming>DoCatWrite</bpmn:incoming><bpmn:outgoing>Cat05</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="CatOwned" name="This account's category?" default="CatNotOwned" gatewayDirection="Diverging"><bpmn:incoming>Cat05</bpmn:incoming><bpmn:outgoing>CatIsOwned</bpmn:outgoing><bpmn:outgoing>CatNotOwned</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:exclusiveGateway id="CatValue" name="Value" default="IsNullValue" gatewayDirection="Diverging"><bpmn:incoming>CatIsOwned</bpmn:incoming><bpmn:outgoing>IsNumber</bpmn:outgoing><bpmn:outgoing>IsNullValue</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="CatSet" name="Store L for this category; 0 is a real limit"><bpmn:incoming>IsNumber</bpmn:incoming><bpmn:outgoing>Cat06</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="CatClear" name="Store NULL: no limit, which is not zero"><bpmn:incoming>IsNullValue</bpmn:incoming><bpmn:outgoing>Cat07</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:exclusiveGateway id="CatJoinWrite" gatewayDirection="Converging"><bpmn:incoming>Cat04</bpmn:incoming><bpmn:incoming>Cat06</bpmn:incoming><bpmn:incoming>Cat07</bpmn:incoming><bpmn:outgoing>Cat08</bpmn:outgoing></bpmn:exclusiveGateway>
    <bpmn:serviceTask id="CatSummary" name="Request GET /api/summary for the month: T per category from saved expenses, paid instalments in, unpaid out; income ignored"><bpmn:incoming>Cat08</bpmn:incoming><bpmn:outgoing>Cat09</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:serviceTask id="CatRows" name="Build rows: every category with spending, plus every limited category at T = 0; Uncategorised only with spending"><bpmn:incoming>Cat09</bpmn:incoming><bpmn:outgoing>Cat10</bpmn:outgoing></bpmn:serviceTask>
    <bpmn:subProcess id="CatJudge" name="Judge each breakdown row">
      <bpmn:incoming>Cat10</bpmn:incoming>
      <bpmn:outgoing>Cat11</bpmn:outgoing>
      <bpmn:multiInstanceLoopCharacteristics id="CatJudgeEachRow"/>
      <bpmn:startEvent id="JStart" name="Row"><bpmn:outgoing>J01</bpmn:outgoing></bpmn:startEvent>
      <bpmn:exclusiveGateway id="JJudged" name="Limit on the row?" default="JHasLimit" gatewayDirection="Diverging"><bpmn:incoming>J01</bpmn:incoming><bpmn:outgoing>JNoLimit</bpmn:outgoing><bpmn:outgoing>JHasLimit</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="JNotSet" name="not_set; limit and remaining NULL; no box"><bpmn:incoming>JNoLimit</bpmn:incoming><bpmn:outgoing>J02</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:exclusiveGateway id="JCompare" name="Compare T with L" default="JOver" gatewayDirection="Diverging"><bpmn:incoming>JHasLimit</bpmn:incoming><bpmn:outgoing>JUnder</bpmn:outgoing><bpmn:outgoing>JEqual</bpmn:outgoing><bpmn:outgoing>JOver</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:serviceTask id="JWithin" name="within; remaining = L − T; white outline"><bpmn:incoming>JUnder</bpmn:incoming><bpmn:outgoing>J03</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="JReached" name="reached; remaining = 0 (also L = 0, T = 0); red box"><bpmn:incoming>JEqual</bpmn:incoming><bpmn:outgoing>J04</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:serviceTask id="JExceeded" name="exceeded; remaining = L − T (negative); red box"><bpmn:incoming>JOver</bpmn:incoming><bpmn:outgoing>J05</bpmn:outgoing></bpmn:serviceTask>
      <bpmn:exclusiveGateway id="JJoin" gatewayDirection="Converging"><bpmn:incoming>J03</bpmn:incoming><bpmn:incoming>J04</bpmn:incoming><bpmn:incoming>J05</bpmn:incoming><bpmn:outgoing>J06</bpmn:outgoing></bpmn:exclusiveGateway>
      <bpmn:endEvent id="JEnd" name="Row judged"><bpmn:incoming>J02</bpmn:incoming><bpmn:incoming>J06</bpmn:incoming></bpmn:endEvent>
      <bpmn:sequenceFlow id="J01" sourceRef="JStart" targetRef="JJudged"></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="JNoLimit" sourceRef="JJudged" targetRef="JNotSet" name="Uncategorised, or L is NULL"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">category_id is NULL or L is NULL</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="JHasLimit" sourceRef="JJudged" targetRef="JCompare" name="L set"></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="J02" sourceRef="JNotSet" targetRef="JEnd"></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="JUnder" sourceRef="JCompare" targetRef="JWithin" name="T &lt; L"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">T &lt; L</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="JEqual" sourceRef="JCompare" targetRef="JReached" name="T = L"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">T = L</bpmn:conditionExpression></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="JOver" sourceRef="JCompare" targetRef="JExceeded" name="T &gt; L"></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="J03" sourceRef="JWithin" targetRef="JJoin"></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="J04" sourceRef="JReached" targetRef="JJoin"></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="J05" sourceRef="JExceeded" targetRef="JJoin"></bpmn:sequenceFlow>
      <bpmn:sequenceFlow id="J06" sourceRef="JJoin" targetRef="JEnd"></bpmn:sequenceFlow>
    </bpmn:subProcess>
    <bpmn:sendTask id="CatDisplay" name="Display limited rows: €T of €L and words; within white outline, reached/over red box; no limit: amount only"><bpmn:incoming>Cat11</bpmn:incoming><bpmn:outgoing>Cat12</bpmn:outgoing></bpmn:sendTask>
    <bpmn:endEvent id="CatEnd" name="Breakdown displayed"><bpmn:incoming>Cat12</bpmn:incoming></bpmn:endEvent>
    <bpmn:sequenceFlow id="Cat01" sourceRef="CatStart" targetRef="CatValidate"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Cat02" sourceRef="CatValidate" targetRef="CatValid"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CatGood" sourceRef="CatValid" targetRef="CatOperation" name="Yes"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">valid</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CatBad" sourceRef="CatValid" targetRef="CatRefuse" name="No"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Cat03" sourceRef="CatRefuse" targetRef="CatRefused"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="DoCatWrite" sourceRef="CatOperation" targetRef="CatFind" name="Limit write"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">PATCH /api/categories/:id</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="DoCatExpense" sourceRef="CatOperation" targetRef="CatExpense" name="Record expense or pay an instalment"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Cat04" sourceRef="CatExpense" targetRef="CatJoinWrite"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Cat05" sourceRef="CatFind" targetRef="CatOwned"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CatIsOwned" sourceRef="CatOwned" targetRef="CatValue" name="Yes"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">row with this id and this user_id</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="CatNotOwned" sourceRef="CatOwned" targetRef="CatRefuse" name="No"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="IsNumber" sourceRef="CatValue" targetRef="CatSet" name="number"><bpmn:conditionExpression xsi:type="bpmn:tFormalExpression">monthly_limit_cents is a number</bpmn:conditionExpression></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="IsNullValue" sourceRef="CatValue" targetRef="CatClear" name="null"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Cat06" sourceRef="CatSet" targetRef="CatJoinWrite"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Cat07" sourceRef="CatClear" targetRef="CatJoinWrite"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Cat08" sourceRef="CatJoinWrite" targetRef="CatSummary"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Cat09" sourceRef="CatSummary" targetRef="CatRows"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Cat10" sourceRef="CatRows" targetRef="CatJudge"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Cat11" sourceRef="CatJudge" targetRef="CatDisplay"></bpmn:sequenceFlow>
    <bpmn:sequenceFlow id="Cat12" sourceRef="CatDisplay" targetRef="CatEnd"></bpmn:sequenceFlow>
  </bpmn:process>
  <bpmndi:BPMNDiagram id="Diagram_CatLimit"><bpmndi:BPMNPlane id="Plane_CatLimit" bpmnElement="Collaboration_CatLimit">
    <bpmndi:BPMNShape id="di_Pool_Person" bpmnElement="Pool_Person" isHorizontal="true"><dc:Bounds x="50" y="40" width="3000" height="90"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="di_Pool_System" bpmnElement="Pool_System" isHorizontal="true"><dc:Bounds x="50" y="195" width="3000" height="730"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="di_CatStart" bpmnElement="CatStart"><dc:Bounds x="115" y="402" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="93" y="445" width="80" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="di_CatValidate" bpmnElement="CatValidate"><dc:Bounds x="200" y="365" width="170" height="110"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="di_CatValid" bpmnElement="CatValid" isMarkerVisible="true"><dc:Bounds x="420" y="395" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="420" y="365" width="50" height="20"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="di_CatRefuse" bpmnElement="CatRefuse"><dc:Bounds x="200" y="700" width="170" height="100"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="di_CatRefused" bpmnElement="CatRefused"><dc:Bounds x="267" y="840" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="312" y="848" width="85" height="20"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="di_CatOperation" bpmnElement="CatOperation" isMarkerVisible="true"><dc:Bounds x="530" y="395" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="590" y="426" width="80" height="20"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="di_CatExpense" bpmnElement="CatExpense"><dc:Bounds x="650" y="215" width="180" height="100"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="di_CatFind" bpmnElement="CatFind"><dc:Bounds x="650" y="510" width="180" height="100"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="di_CatOwned" bpmnElement="CatOwned" isMarkerVisible="true"><dc:Bounds x="880" y="535" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="855" y="490" width="100" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="di_CatValue" bpmnElement="CatValue" isMarkerVisible="true"><dc:Bounds x="990" y="535" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="1045" y="550" width="45" height="20"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="di_CatSet" bpmnElement="CatSet"><dc:Bounds x="1100" y="420" width="180" height="100"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="di_CatClear" bpmnElement="CatClear"><dc:Bounds x="1100" y="605" width="180" height="90"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="di_CatJoinWrite" bpmnElement="CatJoinWrite" isMarkerVisible="true"><dc:Bounds x="1350" y="395" width="50" height="50"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="di_CatSummary" bpmnElement="CatSummary"><dc:Bounds x="1450" y="355" width="190" height="130"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="di_CatRows" bpmnElement="CatRows"><dc:Bounds x="1690" y="355" width="190" height="130"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="di_CatJudge" bpmnElement="CatJudge" isExpanded="true"><dc:Bounds x="1930" y="225" width="730" height="490"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="di_JStart" bpmnElement="JStart"><dc:Bounds x="1960" y="502" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="1958" y="545" width="40" height="20"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="di_JJudged" bpmnElement="JJudged" isMarkerVisible="true"><dc:Bounds x="2030" y="495" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="2015" y="552" width="80" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="di_JNotSet" bpmnElement="JNotSet"><dc:Bounds x="2260" y="250" width="190" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="di_JCompare" bpmnElement="JCompare" isMarkerVisible="true"><dc:Bounds x="2150" y="495" width="50" height="50"/><bpmndi:BPMNLabel><dc:Bounds x="2090" y="440" width="75" height="36"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="di_JWithin" bpmnElement="JWithin"><dc:Bounds x="2260" y="365" width="190" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="di_JReached" bpmnElement="JReached"><dc:Bounds x="2260" y="480" width="190" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="di_JExceeded" bpmnElement="JExceeded"><dc:Bounds x="2260" y="595" width="190" height="80"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="di_JJoin" bpmnElement="JJoin" isMarkerVisible="true"><dc:Bounds x="2500" y="495" width="50" height="50"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="di_JEnd" bpmnElement="JEnd"><dc:Bounds x="2580" y="502" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="2563" y="545" width="70" height="20"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="di_CatDisplay" bpmnElement="CatDisplay"><dc:Bounds x="2710" y="365" width="190" height="110"/></bpmndi:BPMNShape>
    <bpmndi:BPMNShape id="di_CatEnd" bpmnElement="CatEnd"><dc:Bounds x="2950" y="402" width="36" height="36"/><bpmndi:BPMNLabel><dc:Bounds x="2928" y="445" width="80" height="27"/></bpmndi:BPMNLabel></bpmndi:BPMNShape>
    <bpmndi:BPMNEdge id="di_Cat01" bpmnElement="Cat01"><di:waypoint x="151" y="420"/><di:waypoint x="200" y="420"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="di_Cat02" bpmnElement="Cat02"><di:waypoint x="370" y="420"/><di:waypoint x="420" y="420"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="di_CatGood" bpmnElement="CatGood"><di:waypoint x="470" y="420"/><di:waypoint x="530" y="420"/><bpmndi:BPMNLabel><dc:Bounds x="483" y="398" width="35" height="20"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="di_CatBad" bpmnElement="CatBad"><di:waypoint x="445" y="445"/><di:waypoint x="445" y="735"/><di:waypoint x="370" y="735"/><bpmndi:BPMNLabel><dc:Bounds x="453" y="585" width="30" height="20"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="di_Cat03" bpmnElement="Cat03"><di:waypoint x="285" y="800"/><di:waypoint x="285" y="840"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="di_DoCatExpense" bpmnElement="DoCatExpense"><di:waypoint x="555" y="395"/><di:waypoint x="555" y="265"/><di:waypoint x="650" y="265"/><bpmndi:BPMNLabel><dc:Bounds x="565" y="318" width="80" height="48"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="di_DoCatWrite" bpmnElement="DoCatWrite"><di:waypoint x="555" y="445"/><di:waypoint x="555" y="560"/><di:waypoint x="650" y="560"/><bpmndi:BPMNLabel><dc:Bounds x="565" y="500" width="75" height="20"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="di_Cat04" bpmnElement="Cat04"><di:waypoint x="830" y="265"/><di:waypoint x="1375" y="265"/><di:waypoint x="1375" y="395"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="di_Cat05" bpmnElement="Cat05"><di:waypoint x="830" y="560"/><di:waypoint x="880" y="560"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="di_CatIsOwned" bpmnElement="CatIsOwned"><di:waypoint x="930" y="560"/><di:waypoint x="990" y="560"/><bpmndi:BPMNLabel><dc:Bounds x="942" y="538" width="35" height="20"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="di_CatNotOwned" bpmnElement="CatNotOwned"><di:waypoint x="905" y="585"/><di:waypoint x="905" y="775"/><di:waypoint x="370" y="775"/><bpmndi:BPMNLabel><dc:Bounds x="913" y="640" width="30" height="20"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="di_IsNumber" bpmnElement="IsNumber"><di:waypoint x="1015" y="535"/><di:waypoint x="1015" y="470"/><di:waypoint x="1100" y="470"/><bpmndi:BPMNLabel><dc:Bounds x="1030" y="478" width="55" height="20"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="di_IsNullValue" bpmnElement="IsNullValue"><di:waypoint x="1015" y="585"/><di:waypoint x="1015" y="650"/><di:waypoint x="1100" y="650"/><bpmndi:BPMNLabel><dc:Bounds x="1030" y="622" width="35" height="20"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="di_Cat06" bpmnElement="Cat06"><di:waypoint x="1280" y="470"/><di:waypoint x="1320" y="470"/><di:waypoint x="1320" y="420"/><di:waypoint x="1350" y="420"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="di_Cat07" bpmnElement="Cat07"><di:waypoint x="1280" y="650"/><di:waypoint x="1375" y="650"/><di:waypoint x="1375" y="445"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="di_Cat08" bpmnElement="Cat08"><di:waypoint x="1400" y="420"/><di:waypoint x="1450" y="420"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="di_Cat09" bpmnElement="Cat09"><di:waypoint x="1640" y="420"/><di:waypoint x="1690" y="420"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="di_Cat10" bpmnElement="Cat10"><di:waypoint x="1880" y="420"/><di:waypoint x="1930" y="420"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="di_J01" bpmnElement="J01"><di:waypoint x="1996" y="520"/><di:waypoint x="2030" y="520"/></bpmndi:BPMNEdge>
    <bpmndi:BPMNEdge id="di_JNoLimit" bpmnElement="JNoLimit"><di:waypoint x="2055" y="495"/><di:waypoint x="2055" y="290"/><di:waypoint x="2260" y="290"/><bpmndi:BPMNLabel><dc:Bounds x="2063" y="320" width="80" height="48"/></bpmndi:BPMNLabel></bpmndi:BPMNEdge>
